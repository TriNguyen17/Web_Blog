---
import Icon from '../Icon.astro';
---

<dialog class="lightbox" id="lightbox" aria-label="Xem ảnh">
  <div class="lightbox__stage">
    <button class="lightbox__nav lightbox__nav--prev" type="button" data-lb-prev aria-label="Ảnh trước">
      <Icon name="chevron-left" size={26} />
    </button>

    <figure class="lightbox__figure">
      <img class="lightbox__img" id="lightbox-img" src="data:," alt="" />
      <figcaption class="lightbox__info" id="lightbox-info">
        <p class="lightbox__caption" data-lb-caption></p>
        <div class="lightbox__sub">
          <time data-lb-date></time>
          <span class="lightbox__count" data-lb-count></span>
        </div>
        <ul class="tags lightbox__tags" data-lb-tags></ul>
        <a class="lightbox__album" data-lb-album hidden></a>
      </figcaption>
      <p class="sr-only" role="status" data-lb-status></p>
    </figure>

    <button class="lightbox__nav lightbox__nav--next" type="button" data-lb-next aria-label="Ảnh kế tiếp">
      <Icon name="chevron-right" size={26} />
    </button>

    <button class="lightbox__close" type="button" data-lb-close aria-label="Đóng">
      <Icon name="close" size={22} />
    </button>
  </div>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    overflow: hidden;
  }

  .lightbox[open] {
    display: block;
  }

  .lightbox::backdrop {
    background: rgb(1 4 9 / 0.9);
    backdrop-filter: blur(6px);
  }

  .lightbox__stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: clamp(12px, 3vw, 40px);
  }

  .lightbox__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: min(1100px, 92vw);
    max-height: 100%;
    margin: 0;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: 74dvh;
    object-fit: contain;
    border-radius: var(--radius);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.6);
    background: var(--surface-2);
  }

  .lightbox.is-loading .lightbox__img {
    opacity: 0.4;
  }

  /* Spinner while the full-size photo loads; only after a short delay, so a
     cached photo does not flash it. */
  .lightbox.is-loading .lightbox__stage::after {
    content: '';
    position: absolute;
    top: var(--spin-y, 50%);
    left: var(--spin-x, 50%);
    width: 36px;
    height: 36px;
    margin: -18px 0 0 -18px;
    border: 3px solid rgb(255 255 255 / 0.25);
    border-top-color: #fff;
    border-radius: 50%;
    pointer-events: none;
    animation:
      lb-appear 0s 0.2s both,
      lb-spin 0.8s linear infinite;
  }

  @keyframes lb-appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes lb-spin {
    to {
      transform: rotate(1turn);
    }
  }

  .lightbox__info {
    max-width: 680px;
    text-align: center;
    color: #e6edf3;
  }

  .lightbox__caption {
    margin: 0 0 6px;
    font-size: 1rem;
    line-height: 1.5;
  }

  .lightbox__caption:empty {
    display: none;
  }

  .lightbox__sub {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: #8b949e;
  }

  .lightbox__tags {
    justify-content: center;
    margin-top: 10px;
  }

  .lightbox__tags:empty {
    display: none;
  }

  .lightbox__tags :global(.tag) {
    color: #adbac7;
  }

  .lightbox__album {
    display: inline-block;
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #5ae672;
  }

  .lightbox__album:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lightbox__nav,
  .lightbox__close {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgb(22 27 34 / 0.7);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.15s, transform 0.15s;
  }

  .lightbox__nav {
    top: 50%;
    width: 48px;
    height: 48px;
    transform: translateY(-50%);
  }

  .lightbox__nav:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .lightbox__nav--prev {
    left: clamp(8px, 2vw, 28px);
  }

  .lightbox__nav--next {
    right: clamp(8px, 2vw, 28px);
  }

  .lightbox__nav[hidden] {
    display: none;
  }

  .lightbox__close {
    top: clamp(10px, 2vw, 24px);
    right: clamp(10px, 2vw, 24px);
    width: 42px;
    height: 42px;
  }

  .lightbox__close:hover {
    background: var(--cat-pwn);
  }

  @media (max-width: 600px) {
    /* Reserve room for the close button (top) and prev/next (bottom). */
    .lightbox__stage {
      padding-top: 60px;
      padding-bottom: 84px;
    }

    .lightbox__img {
      max-height: calc(100dvh - 330px);
    }

    .lightbox__nav {
      bottom: 18px;
      top: auto;
      transform: none;
    }

    .lightbox__nav--prev {
      left: 50%;
      margin-left: -58px;
    }

    .lightbox__nav--next {
      right: 50%;
      margin-right: -58px;
    }
  }

  /* Tablet and desktop: keep the image clear of the side arrows and of the
     close button. */
  @media (min-width: 601px) {
    .lightbox__stage {
      padding-top: 64px;
    }

    .lightbox__figure {
      max-width: min(1100px, calc(100vw - 2 * (clamp(8px, 2vw, 28px) + 60px)));
    }

    .lightbox__img {
      max-height: calc(100dvh - 280px);
    }
  }

  /* Short landscape screens (phones turned sideways, any width): image and
     caption side by side, arrows back at the sides, so the photo keeps a
     useful size and the tags / album link stay on screen. */
  @media (max-height: 500px) and (orientation: landscape) {
    .lightbox__stage {
      padding: 12px calc(clamp(8px, 2vw, 28px) + 56px);
    }

    .lightbox__figure {
      flex-direction: row;
      align-items: center;
      gap: 18px;
      max-width: 100%;
    }

    .lightbox__img {
      max-width: 58%;
      max-height: calc(100dvh - 24px);
    }

    .lightbox__info {
      flex: 1;
      min-width: 0;
      max-height: calc(100dvh - 24px);
      overflow-y: auto;
      text-align: left;
    }

    .lightbox__sub,
    .lightbox__tags {
      justify-content: flex-start;
    }

    .lightbox__nav {
      top: 50%;
      bottom: auto;
      margin: 0;
      transform: translateY(-50%);
    }

    .lightbox__nav--prev {
      left: clamp(8px, 2vw, 28px);
      right: auto;
    }

    .lightbox__nav--next {
      right: clamp(8px, 2vw, 28px);
      left: auto;
    }
  }
</style>

<script>
  import { initLightbox } from '../../scripts/lightbox';
  initLightbox();
</script>
