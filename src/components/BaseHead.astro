---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { SITE } from '../config';
import { url } from '../lib/utils';

export interface SeoProps {
  title?: string;
  description?: string;
  /** Local image (optimised to a 1200px JPG) or a path inside /public. */
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  /** Alt text of the share image (defaults to the page title). */
  imageAlt?: string;
  /** Structured data (schema.org) for this page. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  imageAlt,
  jsonLd,
} = Astro.props as SeoProps;

const fullTitle = title ? `${title} · ${SITE.brand}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Share cards are 1200x630: local images are cropped to that ratio (scaled
// down when the source is smaller, since images are never enlarged).
let ogW = 1200;
let ogH = 630;
if (typeof image !== 'string') {
  const k = Math.min(image.width / 1200, image.height / 630, 1);
  ogW = Math.round(1200 * k);
  ogH = Math.round(630 * k);
}
const imagePath =
  typeof image === 'string'
    ? url(image)
    : (await getImage({ src: image, width: ogW, height: ogH, fit: 'cover', format: 'jpg' })).src;
const ogImage = new URL(imagePath, Astro.site);
const ogAlt = imageAlt ?? title ?? SITE.title;

const siteUrl = new URL(url('/'), Astro.site).href;
const structured = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    url: siteUrl,
    inLanguage: SITE.lang,
    author: { '@type': 'Person', name: SITE.author },
  },
  ...(jsonLd ? [{ '@context': 'https://schema.org', ...jsonLd }] : []),
];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />
<meta name="theme-color" content="#0d1117" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={SITE.locale} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(ogW)} />
<meta property="og:image:height" content={String(ogH)} />
<meta property="og:image:alt" content={ogAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />

{!noindex && <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, "\\u003c")} />}
