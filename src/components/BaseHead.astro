---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { SITE } from '../config';
import { url } from '../lib/utils';

export interface SeoProps {
  title?: string;
  description?: string;
  /** Local image (optimised to a 1200px JPG) or a path inside /public. */
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
} = Astro.props as SeoProps;

const fullTitle = title ? `${title} · ${SITE.brand}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);

const imagePath =
  typeof image === 'string' ? url(image) : (await getImage({ src: image, width: 1200, format: 'jpg' })).src;
const ogImage = new URL(imagePath, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />
<meta name="theme-color" content="#0d1117" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
