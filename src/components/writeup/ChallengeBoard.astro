---
import { CATEGORIES, DIFFICULTIES, categorySlug, type ChallengeMeta, type CategoryKey } from '../../lib/ctf';
import Icon from '../Icon.astro';

interface Props {
  groups: { category: CategoryKey; challenges: (ChallengeMeta & { slug?: string })[] }[];
}

const { groups } = Astro.props;
const all = groups.flatMap((g) => g.challenges);
const totalPoints = all.reduce((sum, c) => sum + c.points, 0);
/** Baby = 1 … Insane = 5 filled pips. */
const level = (d?: string) => DIFFICULTIES.indexOf(d as (typeof DIFFICULTIES)[number]) + 1;
---

<section class="board" id="challenge-board" aria-labelledby="board-title">
  <div class="board__head">
    <h2 class="board__title" id="board-title">Challenge board</h2>
    <p class="board__stats">
      <span><strong>{all.length}</strong> challenge</span>
      <span><strong>{totalPoints}</strong> pts</span>
    </p>
  </div>

  <div class="board__groups">
    {
      groups.map((group) => (
        <div class="board__group" data-cat={categorySlug(group.category)}>
          <h3 class="board__cat">
            <span class="board__cat-name">{CATEGORIES[group.category].name}</span>
            <span class="board__cat-short" aria-hidden="true">{CATEGORIES[group.category].label}</span>
            <span class="board__cat-count" aria-hidden="true">{group.challenges.length}</span>
            <span class="sr-only">({group.challenges.length} challenge)</span>
          </h3>
          <ul class="board__grid">
            {group.challenges.map((c) => (
              <li>
                {c.slug ? (
                  <a class="board-card" href={`#${c.slug}`} title={`Tới lời giải ${c.name}`}>
                    <span class="board-card__solved" aria-label="Đã giải">
                      <Icon name="check" size={14} />
                    </span>
                    <span class="board-card__name">{c.name}</span>
                    <span class="board-card__pts">
                      {c.points}
                      <span class="board-card__unit">pts</span>
                    </span>
                    {c.difficulty && (
                      <span class="board-card__diff" data-diff={c.difficulty.toLowerCase()}>
                        <span class="pips" aria-hidden="true">
                          {DIFFICULTIES.map((_, i) => (
                            <span class={i < level(c.difficulty) ? 'pip pip--on' : 'pip'} />
                          ))}
                        </span>
                        {c.difficulty}
                      </span>
                    )}
                  </a>
                ) : (
                  <span class="board-card board-card--missing" title="Chưa có lời giải trong bài">
                    <span class="board-card__name">{c.name}</span>
                    <span class="board-card__pts">{c.points}</span>
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .board {
    margin: 32px 0 48px;
    padding: 22px;
    background: var(--bg-sidebar);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    scroll-margin-top: calc(var(--header-h) + 20px);
  }

  .board__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    margin-bottom: 18px;
  }

  .board__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--text);
  }

  .board__title::before {
    content: '$ ls ./challenges';
    content: '$ ls ./challenges' / '';
    display: block;
    margin-bottom: 4px;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--accent);
  }

  .board__stats {
    display: flex;
    gap: 14px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .board__stats strong {
    color: var(--accent);
  }

  /* One column per category, cards stacked inside (CTFd-style board). */
  .board__groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr));
    gap: 24px 16px;
    align-items: start;
  }

  /* Each group spans two rows of the parent grid (title, cards) via subgrid,
     so cards line up even when a category title wraps to two lines. */
  .board__group {
    --cat: var(--c);
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 10px;
  }

  .board__cat {
    display: flex;
    align-items: center;
    align-self: end;
    gap: 10px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c);
  }

  .board__cat::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--c);
    box-shadow: 0 0 10px var(--c);
  }

  .board__cat::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--c) 40%, transparent), transparent);
  }

  .board__cat-short {
    display: none;
  }

  @media (max-width: 600px) {
    .board__cat-short {
      display: inline;
    }
  }

  .board__cat-count {
    padding: 0 7px;
    font-size: 0.7rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .board__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .board-card {
    --c: var(--accent);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-height: 100px;
    /* Side padding keeps the name clear of the solved badge. */
    padding: 16px 32px 14px;
    text-align: center;
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 10%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-top: 3px solid var(--cat, var(--accent));
    border-radius: var(--radius);
    transition:
      background-color 0.18s var(--ease),
      box-shadow 0.18s var(--ease),
      transform 0.18s var(--ease),
      border-color 0.18s var(--ease);
  }

  a.board-card:hover,
  a.board-card:focus-visible {
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 30%, var(--surface));
    border-color: var(--accent);
    box-shadow: var(--accent-glow);
    transform: translateY(-2px);
  }

  .board-card__name {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .board-card__pts {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--accent-text);
  }

  .board-card__unit {
    margin-left: 3px;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .board-card__diff {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.68rem;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .pips {
    display: inline-flex;
    gap: 3px;
  }

  .pip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--text-faint) 45%, transparent);
  }

  .board-card__diff[data-diff='baby'] { --d: var(--diff-baby); }
  .board-card__diff[data-diff='easy'] { --d: var(--diff-easy); }
  .board-card__diff[data-diff='medium'] { --d: var(--diff-medium); }
  .board-card__diff[data-diff='hard'] { --d: var(--diff-hard); }
  .board-card__diff[data-diff='insane'] { --d: var(--diff-insane); }

  .pip--on {
    background: var(--d, var(--accent));
  }

  .board-card__solved {
    position: absolute;
    top: 7px;
    right: 7px;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    color: var(--accent-ink);
    background: var(--accent);
    border-radius: 50%;
  }

  .board-card--missing {
    opacity: 0.55;
    background: var(--surface);
    border-style: dashed;
    border-color: var(--border);
  }

  /* Phones: two category columns and shorter cards, so the board does not
     push the write-up several screens down. */
  @media (max-width: 600px) {
    .board {
      padding: 16px;
    }

    .board__groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 10px;
    }

    .board__cat {
      font-size: 0.68rem;
      letter-spacing: 0.04em;
    }

    .board__cat-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .board-card {
      min-height: 0;
      padding: 20px 10px 10px;
    }

    .board-card__name {
      overflow-wrap: break-word;
    }

    .board-card__solved {
      top: 5px;
      right: 5px;
      width: 16px;
      height: 16px;
    }

    .board-card__pts {
      font-size: 1.1rem;
    }
  }
</style>
