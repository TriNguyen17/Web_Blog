---
import { NAV, SITE } from '../config';
import { url } from '../lib/utils';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => {
  const target = url(href);
  return href === '/' ? path === target : path.startsWith(target);
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={url('/')}>
      <span class="brand__path">~/{SITE.brand}</span>
      <span class="brand__prompt" aria-hidden="true">$</span>
      <span class="brand__cursor" aria-hidden="true"></span>
      <span class="sr-only">— trang chủ</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Điều hướng chính" data-open="false">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <button class="search-trigger" type="button" data-search-open aria-keyshortcuts="Control+K /">
        <Icon name="search" size={16} />
        <span class="search-trigger__label">Tìm kiếm…</span>
        <kbd class="search-trigger__kbd" aria-hidden="true">Ctrl K</kbd>
      </button>
      <ThemeToggle />
      <button
        class="icon-btn nav-toggle"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Mở menu"
        data-nav-toggle
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--border-soft);
  }

  /* Older Safari only supports the prefixed property. Kept in its own rule:
     the minifier merges a prefixed/unprefixed pair into one declaration. */
  @supports (-webkit-backdrop-filter: none) {
    .site-header {
      -webkit-backdrop-filter: saturate(160%) blur(12px);
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }

  .brand__path {
    color: var(--accent);
  }

  .brand__prompt {
    color: var(--text-muted);
  }

  .brand__cursor {
    width: 9px;
    height: 1.1em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand__cursor {
      animation: none;
    }
  }

  .site-nav ul {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: block;
    padding: 6px 12px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--text-muted);
    border-radius: var(--radius);
    transition: color 0.15s, background-color 0.15s;
  }

  .site-nav a:hover {
    color: var(--text);
    background: var(--surface);
  }

  .site-nav a[aria-current='page'] {
    color: var(--accent);
  }

  .site-nav a[aria-current='page']::before {
    content: './';
    content: './' / '';
    opacity: 0.6;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 8px 0 12px;
    font-size: 0.85rem;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .search-trigger:hover {
    color: var(--text);
    border-color: var(--accent-border);
  }

  .search-trigger__label {
    min-width: 90px;
    text-align: left;
  }

  .nav-toggle {
    display: none;
  }

  @media (max-width: 860px) {
    .search-trigger__kbd {
      display: none;
    }

    /* Visually hidden but still the button's accessible name. */
    .search-trigger__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .search-trigger {
      width: 38px;
      padding: 0;
      justify-content: center;
      background: transparent;
      border-color: transparent;
    }

    .nav-toggle {
      display: inline-grid;
    }

    .site-nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      padding: 12px var(--gutter) 20px;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.18s var(--ease), transform 0.18s var(--ease), visibility 0.18s;
    }

    .site-nav[data-open='true'] {
      transform: none;
      opacity: 1;
      visibility: visible;
      transition:
        opacity 0.18s var(--ease),
        transform 0.18s var(--ease),
        visibility 0s;
    }

    .site-nav ul {
      flex-direction: column;
    }

    .site-nav a {
      padding: 12px;
      font-size: 1rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('site-nav');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      nav.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Đóng menu' : 'Mở menu');
      // Move keyboard focus into the menu once it is visible (retry a few
      // frames; preventScroll: the menu is fixed, nothing needs scrolling).
      if (open) {
        let tries = 0;
        const focusIn = () => {
          const link = nav.querySelector<HTMLElement>('a');
          if (!link) return;
          link.focus({ preventScroll: true });
          if (document.activeElement !== link && tries++ < 10) requestAnimationFrame(focusIn);
        };
        requestAnimationFrame(focusIn);
      }
    };

    toggle.addEventListener('click', () => setOpen(nav.dataset.open !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      // defaultPrevented: Esc already closed a dialog on top (search).
      if (e.key === 'Escape' && !e.defaultPrevented && nav.dataset.open === 'true') {
        setOpen(false);
        toggle.focus({ preventScroll: true });
      }
    });
    document.addEventListener('click', (e) => {
      const target = e.target as Element;
      if (target.closest?.('dialog')) return; // clicks inside the search dialog
      if (nav.dataset.open === 'true' && !nav.contains(target) && !toggle.contains(target)) setOpen(false);
    });
    // Tabbing out of the open menu closes it (but not when a dialog such as
    // search opens on top: focus returns to the menu when it closes).
    nav.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as HTMLElement | null;
      if (nav.dataset.open !== 'true' || !next || nav.contains(next) || next === toggle) return;
      if (next.closest('dialog')) return;
      setOpen(false);
    });
  }

  // Keyboard focus moving up the page can land under the sticky header (the
  // browser scrolls the element to the very top). Nudge it back into view.
  const header = document.querySelector<HTMLElement>('.site-header');
  document.addEventListener('focusin', (e) => {
    const el = e.target;
    if (!header || !(el instanceof HTMLElement) || !el.closest('main') || el.closest('#toc, dialog')) return;
    if (!el.matches(':focus-visible')) return;
    requestAnimationFrame(() => {
      const headerBottom = header.getBoundingClientRect().bottom;
      const top = el.getBoundingClientRect().top;
      if (top < headerBottom + 8) window.scrollBy({ top: top - headerBottom - 16, behavior: 'instant' });
    });
  });
</script>
