---
/**
 * Web fonts: only the Latin and Vietnamese subsets of Inter and JetBrains
 * Mono (variable). The full Fontsource CSS also declares latin-ext, whose
 * range overlaps Vietnamese letters, so every page downloaded an extra 85 KB.
 * Vietnamese is declared last so it wins where the ranges overlap.
 */
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interVi from '@fontsource-variable/inter/files/inter-vietnamese-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import monoVi from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-vietnamese-wght-normal.woff2?url';

const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const VIETNAMESE =
  'U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB';

const face = (family: string, src: string, range: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:100 900;src:url(${src}) format('woff2-variations');unicode-range:${range}}`;

const css = [
  face('Inter Variable', interLatin, LATIN),
  face('Inter Variable', interVi, VIETNAMESE),
  face('JetBrains Mono Variable', monoLatin, LATIN),
  face('JetBrains Mono Variable', monoVi, VIETNAMESE),
].join('');
---

<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css}></style>
