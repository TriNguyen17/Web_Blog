---
import { HERO, SITE } from '../config';
import { url } from '../lib/utils';
import { parseRank } from '../lib/ctf';
import { writeupUrl, photoPostUrl, type Writeup, type PhotoPost } from '../lib/posts';
import Icon from './Icon.astro';

interface Props {
  writeups: Writeup[];
  photos: PhotoPost[];
}

/**
 * Hero with a terminal that prints real, linked content (newest write-ups,
 * CTF totals, albums), built at every deploy. The lines "type" in once per
 * session when motion is allowed; otherwise they are just there.
 */
const { writeups, photos } = Astro.props;
const whoami = HERO.terminal[0];
const recent = writeups.slice(0, 3);
const challenges = writeups.reduce((n, w) => n + w.data.challenges.length, 0);
const points = writeups.reduce((n, w) => n + w.data.challenges.reduce((s, c) => s + c.points, 0), 0);
const best = writeups
  .map((w) => parseRank(w.data.ctf.rank))
  .filter((r) => r !== undefined)
  .sort((a, b) => a!.top - b!.top)[0];
const albums = photos.slice(0, 2);
let line = 0;
const next = () => `--i:${line++}`;
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow">whoami</p>
      <h1 class="hero__title">{HERO.greeting}</h1>
      <p class="hero__intro">{HERO.intro}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={url('/writeups/')}>
          <Icon name="flag" size={16} /> Đọc write-ups
        </a>
        <a class="btn" href={url('/photos/')}>
          <Icon name="image" size={16} /> Xem ảnh
        </a>
      </div>
    </div>

    <div class="hero__terminal">
      <section class="term" aria-label="Terminal: nội dung mới nhất trên blog">
        <div class="term__bar" aria-hidden="true">
          <span class="term__dot"></span><span class="term__dot"></span><span class="term__dot"></span>
          <span class="term__title">{SITE.brand}@blog: ~</span>
        </div>
        <div class="term__body">
          {whoami && (
            <div class="term__block term__block--whoami">
              <p class="term__line" style={next()}><span class="term__prompt" aria-hidden="true">$</span> {whoami.cmd}</p>
              <p class="term__out" style={next()}>{whoami.out}</p>
            </div>
          )}

          {recent.length > 0 && (
            <div class="term__block">
              <p class="term__line" style={next()}><span class="term__prompt" aria-hidden="true">$</span> ls -t writeups/ | head -{recent.length}</p>
              <ul class="term__out term__list" style={next()}>
                {recent.map((w) => (
                  <li>
                    <a href={writeupUrl(w)}>{w.id}/</a>
                    {w.data.ctf.rank && <span class="term__dim"> # hạng {w.data.ctf.rank}</span>}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {challenges > 0 && (
            <div class="term__block">
              <p class="term__line" style={next()}><span class="term__prompt" aria-hidden="true">$</span> ctf --stats</p>
              <p class="term__out" style={next()}>
                <span class="term__num">{writeups.length}</span> giải · <span class="term__num">{challenges}</span> challenge ·{' '}
                <span class="term__num">{points}</span> pts
                {best && (
                  <>
                    {' '}· tốt nhất <span class="term__num">#{best.pos}</span>
                    <span class="term__dim">/{best.total}</span>
                  </>
                )}
              </p>
            </div>
          )}

          {albums.length > 0 && (
            <div class="term__block term__block--photos">
              <p class="term__line" style={next()}><span class="term__prompt" aria-hidden="true">$</span> ls photos/</p>
              <ul class="term__out term__list" style={next()}>
                {albums.map((p) => (
                  <li>
                    <a href={photoPostUrl(p)}>{p.id}/</a>
                    <span class="term__dim"> ({p.data.photos.length} ảnh)</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <p class="term__line" style={next()} aria-hidden="true"><span class="term__prompt">$</span> <span class="term__cursor"></span></p>
        </div>
      </section>
    </div>
  </div>
</section>

<script is:inline>
  // Type the terminal in once per session (skipped with reduced motion).
  (function () {
    try {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || sessionStorage.getItem('hero-typed')) return;
      sessionStorage.setItem('hero-typed', '1');
      document.documentElement.classList.add('hero-type');
    } catch (e) {}
  })();
</script>

<style>
  .hero {
    position: relative;
    padding: clamp(40px, 7vw, 84px) 0 clamp(32px, 5vw, 56px);
    overflow: hidden;
    border-bottom: 1px solid var(--border-soft);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 80% at 15% 0%, var(--accent-softer), transparent 60%),
      radial-gradient(40% 60% at 100% 10%, color-mix(in srgb, var(--cat-osint) 8%, transparent), transparent 70%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
  }

  .hero__title {
    margin: 0 0 16px;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.02em;
  }

  .hero__intro {
    margin: 0 0 24px;
    max-width: 48ch;
    font-size: 1.08rem;
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Terminal mock */
  .term {
    background: var(--bg-sidebar);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .term__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 14px;
    background: var(--surface);
    border-bottom: 1px solid var(--border-soft);
  }

  .term__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border);
  }

  .term__dot:nth-child(1) {
    background: #ff5f56;
  }
  .term__dot:nth-child(2) {
    background: #ffbd2e;
  }
  .term__dot:nth-child(3) {
    background: #27c93f;
  }

  .term__title {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-faint);
  }

  .term__body {
    padding: 18px 18px 20px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .term__body p {
    margin: 0;
  }

  .term__prompt {
    color: var(--accent);
  }

  .term__line {
    color: var(--text);
  }

  .term__body .term__out {
    margin-bottom: 10px;
    color: var(--text-muted);
  }

  .term__body .term__list {
    margin: 0 0 10px;
    padding: 0;
    list-style: none;
  }

  .term__list a {
    color: var(--accent-text);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    text-underline-offset: 3px;
  }

  .term__list a:hover {
    text-decoration-color: currentColor;
  }

  .term__dim {
    color: var(--text-faint);
  }

  .term__num {
    color: var(--text);
    font-weight: 600;
  }

  /* Typing effect: each line is uncovered left to right, one after another. */
  :global(.hero-type) .term__body > :is(p, div) > *,
  :global(.hero-type) .term__body > p {
    animation: term-type 0.32s steps(18, end) both;
    animation-delay: calc(var(--i, 0) * 170ms + 150ms);
  }

  @keyframes term-type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .term__cursor {
    display: inline-block;
    width: 8px;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .term__cursor {
      animation: none;
    }
  }

  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    /* Phones and tablets: text first, then a shorter terminal. */
    .term__block--whoami,
    .term__block--photos {
      display: none;
    }
  }
</style>
