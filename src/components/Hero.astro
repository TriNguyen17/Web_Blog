---
import { HERO, SITE } from '../config';
import { url } from '../lib/utils';
import Icon from './Icon.astro';
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow">whoami</p>
      <h1 class="hero__title">{HERO.greeting}</h1>
      <p class="hero__intro">{HERO.intro}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={url('/writeups/')}>
          <Icon name="flag" size={16} /> Đọc write-ups
        </a>
        <a class="btn" href={url('/photos/')}>
          <Icon name="image" size={16} /> Xem ảnh
        </a>
      </div>
    </div>

    <div class="hero__terminal" aria-hidden="true">
      <div class="term">
        <div class="term__bar">
          <span class="term__dot"></span><span class="term__dot"></span><span class="term__dot"></span>
          <span class="term__title">{SITE.brand}@blog: ~</span>
        </div>
        <div class="term__body">
          {
            HERO.terminal.map((line) => (
              <>
                <p class="term__line"><span class="term__prompt">$</span> {line.cmd}</p>
                <p class="term__out">{line.out}</p>
              </>
            ))
          }
          <p class="term__line"><span class="term__prompt">$</span> <span class="term__cursor"></span></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(40px, 7vw, 84px) 0 clamp(32px, 5vw, 56px);
    overflow: hidden;
    border-bottom: 1px solid var(--border-soft);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 80% at 15% 0%, var(--accent-softer), transparent 60%),
      radial-gradient(40% 60% at 100% 10%, color-mix(in srgb, var(--cat-osint) 8%, transparent), transparent 70%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
  }

  .hero__title {
    margin: 0 0 16px;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.02em;
  }

  .hero__intro {
    margin: 0 0 24px;
    max-width: 48ch;
    font-size: 1.08rem;
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Terminal mock */
  .term {
    background: var(--bg-sidebar);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .term__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 14px;
    background: var(--surface);
    border-bottom: 1px solid var(--border-soft);
  }

  .term__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border);
  }

  .term__dot:nth-child(1) {
    background: #ff5f56;
  }
  .term__dot:nth-child(2) {
    background: #ffbd2e;
  }
  .term__dot:nth-child(3) {
    background: #27c93f;
  }

  .term__title {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-faint);
  }

  .term__body {
    padding: 18px 18px 20px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .term__body p {
    margin: 0;
  }

  .term__prompt {
    color: var(--accent);
  }

  .term__line {
    color: var(--text);
  }

  .term__body .term__out {
    margin-bottom: 10px;
    color: var(--text-muted);
  }

  .term__cursor {
    display: inline-block;
    width: 8px;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .term__cursor {
      animation: none;
    }
  }

  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__terminal {
      order: -1;
    }
  }
</style>
