---
import { Image } from 'astro:assets';
import type { FeedItem } from '../lib/posts';
import { CATEGORIES, categorySlug, parseRank } from '../lib/ctf';
import { formatDate, isoDate } from '../lib/utils';
import Icon from './Icon.astro';
import TagList from './TagList.astro';

interface Props {
  item: FeedItem;
  /** Load the cover eagerly (first cards above the fold). */
  eager?: boolean;
  /** Heading level of the card title (2 when the list sits right under the page h1). */
  headingLevel?: 2 | 3;
}

const { item, eager = false, headingLevel = 3 } = Astro.props;
const categories = [...new Set(item.categories)];
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const rank = parseRank(item.ctf?.rank);
const catPoints = item.catPoints ?? [];
const ctfLine = [item.ctf?.format, item.ctf?.team && `team ${item.ctf.team}`].filter(Boolean).join(' · ');
---

{
  item.type === 'writeup' ? (
    <article
      class="post-card post-card--writeup"
      data-type="writeup"
      data-tags={item.tags.join(',')}
      data-cats={categories.map(categorySlug).join(',')}
      data-reveal
    >
      <div class="post-card__top">
        <span class="post-card__kind">
          <Icon name="flag" size={14} /> CTF write-up
        </span>
        <time datetime={isoDate(item.date)}>{formatDate(item.date)}</time>
      </div>
      <Heading class="post-card__title">
        <a href={item.href}>{item.title}</a>
      </Heading>
      <p class="post-card__desc">{item.description}</p>
      {item.ctf && (
        <p class="score__ctf">
          <span class="score__ctf-name">{item.ctf.name}</span>
          {ctfLine && <span class="score__ctf-meta">{ctfLine}</span>}
        </p>
      )}
      {((item.solved ?? 0) > 0 || item.ctf?.rank) && (
        <dl class="score">
          {item.ctf?.rank && (
            <div>
              <dt>Hạng</dt>
              <dd>
                {rank ? (
                  <>
                    {rank.pos}
                    <span class="score__of">/{rank.total}</span>
                  </>
                ) : (
                  item.ctf.rank
                )}
              </dd>
            </div>
          )}
          {(item.solved ?? 0) > 0 && (
            <>
              <div>
                <dt>Đã giải</dt>
                <dd>{item.solved}</dd>
              </div>
              <div>
                <dt>Điểm</dt>
                <dd>{item.points}</dd>
              </div>
            </>
          )}
        </dl>
      )}
      {catPoints.length > 0 && (
        <div class="score__cats">
          <div class="score__bar" aria-hidden="true">
            {catPoints.map((c) => (
              <span data-cat={categorySlug(c.category)} style={`flex-grow:${c.points || c.count}`} />
            ))}
          </div>
          <ul class="score__legend" aria-label="Challenge theo category">
            {catPoints.map((c) => (
              <li data-cat={categorySlug(c.category)} title={CATEGORIES[c.category].name}>
                {c.category}
                <span class="score__legend-n">{c.count}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
      <TagList tags={item.tags} class="post-card__tags" />
    </article>
  ) : (
    <article class="post-card post-card--photo" data-type="photo" data-tags={item.tags.join(',')} data-reveal>
      {item.cover && (
        <div class="post-card__media">
          <Image
            src={item.cover}
            alt=""
            widths={[400, 640, 900]}
            sizes="(min-width: 1200px) 380px, (min-width: 700px) 45vw, 100vw"
            loading={eager ? 'eager' : 'lazy'}
          />
          <span class="post-card__count">
            <Icon name="image" size={14} /> {item.photoCount} ảnh
          </span>
        </div>
      )}
      <div class="post-card__body">
        <div class="post-card__top">
          <span class="post-card__kind post-card__kind--photo">Photo</span>
          <time datetime={isoDate(item.date)}>{formatDate(item.date)}</time>
        </div>
        <Heading class="post-card__title">
          <a href={item.href}>{item.title}</a>
        </Heading>
        <p class="post-card__desc">{item.description}</p>
        <TagList tags={item.tags} class="post-card__tags" />
      </div>
    </article>
  )
}

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .post-card:hover {
    transform: translateY(-3px);
  }

  /* --- write-up: terminal-like card --- */
  .post-card--writeup {
    padding: 20px;
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, var(--accent-softer), transparent 40%),
      var(--surface);
  }

  .post-card--writeup:hover {
    border-color: var(--accent-border);
    box-shadow: var(--accent-glow);
  }

  .post-card--writeup .post-card__title {
    font-family: var(--font-mono);
    font-size: 1.08rem;
  }

  /* --- photo: softer card --- */
  .post-card--photo {
    overflow: hidden;
    border-radius: var(--radius-soft);
    border-color: var(--border-soft);
  }

  .post-card--photo:hover {
    box-shadow: var(--shadow);
    border-color: var(--border);
  }

  .post-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-2);
  }

  .post-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .post-card--photo:hover .post-card__media :global(img) {
    transform: scale(1.04);
  }

  .post-card__count {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(6px);
    border-radius: 999px;
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 20px 20px;
  }

  .post-card--photo .post-card__title {
    font-size: 1.12rem;
    font-weight: 650;
  }

  /* --- shared --- */
  .post-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .post-card__kind {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-text);
  }

  .post-card__kind--photo {
    color: var(--cat-osint);
  }

  .post-card__title {
    margin: 0;
    line-height: 1.35;
  }

  .post-card__title a {
    color: var(--text);
  }

  /* Whole card clickable; tags stay clickable above the overlay. */
  .post-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .post-card:hover .post-card__title a {
    color: var(--accent);
  }

  .post-card__desc {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* --- write-up scoreboard --- */
  .score__ctf {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .score__ctf-name {
    font-weight: 600;
    color: var(--text);
  }

  .score__ctf-meta {
    color: var(--text-muted);
  }

  .score {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    margin: 0;
    background: var(--bg-sidebar);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
  }

  .score > div {
    padding: 8px 12px;
  }

  .score > div + div {
    border-left: 1px solid var(--border-soft);
  }

  .score dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .score dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
  }

  .score__of {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-faint);
  }

  .score__cats {
    display: grid;
    gap: 8px;
  }

  .score__bar {
    display: flex;
    gap: 2px;
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
  }

  .score__bar span {
    flex-basis: 0;
    background: var(--c);
  }

  .score__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .score__legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .score__legend li::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--c);
  }

  .score__legend-n {
    color: var(--text-faint);
  }

  .post-card :global(.post-card__tags) {
    position: relative;
    z-index: 1;
    margin-top: auto;
  }
</style>
