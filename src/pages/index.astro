---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PostCard from '../components/PostCard.astro';
import FilterBar from '../components/FilterBar.astro';
import Icon from '../components/Icon.astro';
import { getWriteups, getPhotoPosts, writeupToFeed, photoPostToFeed } from '../lib/posts';
import { SITE } from '../config';
import { url } from '../lib/utils';

// The newest posts of each type, so a run of write-ups never pushes every
// album off the home page (and the other way round).
const [writeups, photos] = await Promise.all([getWriteups(), getPhotoPosts()]);
const N = SITE.homePostsPerType;
const latestWriteups = writeups.slice(0, N).map(writeupToFeed);
const latestPhotos = photos.slice(0, N).map(photoPostToFeed);
const latest = [...latestWriteups, ...latestPhotos].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const filterOptions = [
  { value: 'writeup', label: 'CTF Write-ups', count: latestWriteups.length },
  { value: 'photo', label: 'Ảnh', count: latestPhotos.length },
];
---

<BaseLayout>
  <Hero writeups={writeups} photos={photos} />

  <section class="page container">
    <div class="section-title">
      <h2 id="latest">Mới nhất</h2>
      <a class="see-all" href={url('/archive/')}>Xem tất cả bài <Icon name="arrow-right" size={14} /></a>
    </div>

    {
      latest.length === 0 ? (
        <p class="empty-state">Chưa có bài viết nào.</p>
      ) : (
        <div data-filter-root>
          <FilterBar options={filterOptions} total={latest.length} label="Lọc bài viết theo loại" />

          <div class="card-grid" data-filter-items>
            {latest.map((item, i) => <PostCard item={item} eager={i < 2} />)}
          </div>

          <p class="empty-state" data-filter-empty hidden>Không có bài viết nào thuộc loại này.</p>
        </div>
      )
    }
  </section>

  <script>
    import { initFilters } from '../scripts/filter';
    initFilters();
  </script>
</BaseLayout>

<style>
  .see-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .see-all:hover {
    color: var(--accent);
  }
</style>
