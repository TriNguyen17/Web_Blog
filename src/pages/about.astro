---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, SOCIALS, HERO } from '../config';
import { url, isoDate } from '../lib/utils';
import { getWriteups, getPhotoPosts, writeupUrl } from '../lib/posts';
import { CATEGORIES, DIFFICULTIES, categorySlug, parseRank, type CategoryKey } from '../lib/ctf';

/**
 * About page as a small CTF résumé: everything below is computed from the
 * write-up frontmatter (ctf.* and challenges), so it updates with each post.
 */
const [writeups, photos] = await Promise.all([getWriteups(), getPhotoPosts()]);
const allChallenges = writeups.flatMap((e) => e.data.challenges);
const totalPoints = allChallenges.reduce((sum, c) => sum + c.points, 0);
const nf = new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 1 });

const competitions = writeups.map((e) => ({
  href: writeupUrl(e),
  name: e.data.ctf.name,
  date: e.data.ctf.date,
  when: e.data.pubDate,
  format: e.data.ctf.format,
  team: e.data.ctf.team,
  rank: e.data.ctf.rank,
  parsed: parseRank(e.data.ctf.rank),
  solved: e.data.challenges.length,
  points: e.data.challenges.reduce((sum, c) => sum + c.points, 0),
  cats: [...new Set(e.data.challenges.map((c) => c.category))],
}));
const best = competitions.filter((c) => c.parsed).sort((a, b) => a.parsed!.top - b.parsed!.top)[0];

// Category x difficulty matrix (rows: categories with at least one solve).
const cats = (Object.keys(CATEGORIES) as CategoryKey[]).filter((k) => allChallenges.some((c) => c.category === k));
const cell = (cat: CategoryKey, diff: string) =>
  allChallenges.filter((c) => c.category === cat && c.difficulty === diff).length;
const rowTotal = (cat: CategoryKey) => allChallenges.filter((c) => c.category === cat).length;
const showUnrated = allChallenges.some((c) => !c.difficulty);

const stats = [
  { label: 'Giải CTF', value: writeups.length },
  { label: 'Challenge', value: allChallenges.length },
  { label: 'Điểm', value: totalPoints },
  { label: 'Album ảnh', value: photos.length },
];
---

<BaseLayout title="About" description={`Giới thiệu về ${SITE.author} và blog.`}>
  <div class="page container about">
    <header class="page-header">
      <p class="eyebrow">cat about.md</p>
      <h1>Về mình</h1>
    </header>

    <div class="about__grid">
      <div class="prose about__bio">
        <p>{HERO.intro}</p>
        <p>
          Mình lập blog này để lưu lại quá trình học và chơi CTF — vừa như một cuốn sổ tay cho chính mình, vừa hy vọng
          giúp được ai đó đang mắc ở một challenge tương tự. Mỗi write-up mình cố gắng trình bày theo đúng mạch suy
          nghĩ khi giải: từ lúc nhìn đề, phát hiện lỗ hổng, lên ý tưởng, cho đến script khai thác hoàn chỉnh.
        </p>
        <p>
          Ngoài bàn phím và màn hình terminal, mình thích chụp ảnh. Mục <a href={url('/photos/')}>Photos</a> là nơi mình để
          những tấm hình đời thường cho nhẹ đầu sau những đêm debug.
        </p>

        <h2>Mình quan tâm tới</h2>
        <ul>
          <li><strong>Reverse Engineering</strong> — tháo gỡ binary, phân tích thuật toán, anti-debug.</li>
          <li><strong>Digital Forensics</strong> — phân tích pcap, memory dump, điều tra sự cố.</li>
          <li>Web Exploitation, Cryptography và một chút Pwn.</li>
        </ul>

        {
          competitions.length > 0 && (
            <>
              <h2>Thành tích CTF</h2>
              <p class="highlight">
                {best && (
                  <>
                    <span class="highlight__label">Hạng tốt nhất</span>{' '}
                    <strong>{best.parsed!.pos}/{best.parsed!.total}</strong> tại {best.name}
                    <span class="muted"> (top {nf.format(best.parsed!.top)}%)</span>
                    <br />
                  </>
                )}
                <span class="highlight__label">Tổng cộng</span> {competitions.length} giải · {allChallenges.length}{' '}
                challenge · {totalPoints} điểm
              </p>

              <h2>Lịch sử thi đấu</h2>
              <div class="table-wrap">
                <table class="history">
                  <thead>
                    <tr>
                      <th scope="col">Thời gian</th>
                      <th scope="col">Giải</th>
                      <th scope="col">Hình thức</th>
                      <th scope="col">Team</th>
                      <th scope="col">Hạng</th>
                      <th scope="col">Đã giải</th>
                    </tr>
                  </thead>
                  <tbody>
                    {competitions.map((c) => (
                      <tr>
                        <td data-label="Thời gian">
                          {c.date ?? <time datetime={isoDate(c.when)}>{isoDate(c.when)}</time>}
                        </td>
                        <th scope="row" data-label="Giải">
                          <a href={c.href}>{c.name}</a>
                        </th>
                        <td data-label="Hình thức">{c.format ?? '—'}</td>
                        <td data-label="Team">{c.team ?? '—'}</td>
                        <td data-label="Hạng" class="history__rank">
                          {c.rank ?? '—'}
                          {c.parsed && <span class="muted"> · top {nf.format(c.parsed.top)}%</span>}
                        </td>
                        <td data-label="Đã giải">
                          {c.solved} challenge · {c.points} pts
                          <span class="history__cats">
                            {c.cats.map((cat) => (
                              <span class="cat-badge" data-cat={categorySlug(cat)}>{cat}</span>
                            ))}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <h2 id="by-category">Challenge theo category</h2>
              <div class="table-wrap" tabindex="0" role="region" aria-labelledby="by-category">
                <table class="matrix">
                  <caption class="sr-only">Số challenge đã giải theo category và độ khó</caption>
                  <thead>
                    <tr>
                      <th scope="col">Category</th>
                      {DIFFICULTIES.map((d) => <th scope="col">{d}</th>)}
                      {showUnrated && <th scope="col">Khác</th>}
                      <th scope="col">Tổng</th>
                    </tr>
                  </thead>
                  <tbody>
                    {cats.map((cat) => (
                      <tr>
                        <th scope="row">
                          <span class="cat-badge" data-cat={categorySlug(cat)}>{cat}</span>
                          <span class="matrix__name">{CATEGORIES[cat].name}</span>
                        </th>
                        {DIFFICULTIES.map((d) => {
                          const n = cell(cat, d);
                          return <td class={n ? 'matrix__n' : 'matrix__zero'}>{n || '·'}</td>;
                        })}
                        {showUnrated && (
                          <td class="matrix__zero">{allChallenges.filter((c) => c.category === cat && !c.difficulty).length || '·'}</td>
                        )}
                        <td class="matrix__total">{rowTotal(cat)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </>
          )
        }
      </div>

      <aside class="about__side">
        <div class="stat-card">
          <h2 class="about__side-title">Thống kê</h2>
          <ul class="stats">
            {
              stats.map((s) => (
                <li>
                  <span class="stats__value">{s.value}</span>
                  <span class="stats__label">{s.label}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="links-card">
          <h2 class="about__side-title">Liên hệ & profile</h2>
          <ul class="link-list">
            {
              SOCIALS.map((s) => {
                const external = /^https?:/.test(s.url);
                return (
                  <li>
                    <a href={s.url} target={external ? '_blank' : undefined} rel={external ? 'me noopener' : undefined}>
                      <span class="link-list__icon">
                        <Icon name={s.icon} size={18} />
                      </span>
                      <span class="link-list__text">
                        <span class="link-list__name">{s.name}</span>
                        <span class="link-list__handle">{s.handle}</span>
                      </span>
                      {external && <Icon name="external" size={14} />}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 40px;
    align-items: start;
  }

  .highlight {
    padding: 14px 18px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.9;
    background: var(--bg-sidebar);
    border: 1px solid var(--border-soft);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
  }

  .highlight__label {
    color: var(--text-faint);
  }

  .highlight strong {
    color: var(--accent-text);
  }

  .muted {
    color: var(--text-muted);
  }

  .table-wrap {
    overflow-x: auto;
  }

  .about__bio .matrix {
    display: table;
    width: max-content;
    min-width: 100%;
  }

  .about__bio :is(.history, .matrix) {
    width: 100%;
    margin: 0;
    font-size: 0.88rem;
  }

  .history th[scope='row'] {
    font-weight: 600;
    text-align: left;
  }

  .history__rank {
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .history__cats {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 6px;
  }

  .matrix th,
  .matrix td {
    text-align: center;
    font-family: var(--font-mono);
  }

  .matrix th[scope='row'] {
    display: flex;
    align-items: center;
    gap: 10px;
    text-align: left;
    font-family: var(--font-sans);
    font-weight: 500;
  }

  .matrix__name {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .matrix__n {
    font-weight: 700;
    color: var(--accent-text);
  }

  .matrix__zero {
    color: var(--text-faint);
  }

  .matrix__total {
    font-weight: 700;
  }

  /* Phones: each competition becomes a small labelled card. */
  @media (max-width: 640px) {
    .history thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .history,
    .history tbody,
    .history tr,
    .history :is(td, th) {
      display: block;
    }

    .history tr {
      margin-bottom: 12px;
      padding: 10px 14px;
      background: var(--bg-sidebar);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius);
    }

    .about__bio .history :is(td, th) {
      padding: 4px 0;
      border: 0;
      background: none;
    }

    .history :is(td, th)::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-faint);
    }

    .matrix__name {
      display: none;
    }
  }

  .about__side {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: 20px;
  }

  .stat-card,
  .links-card {
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .about__side-title {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .about__side-title::before {
    content: '// ';
    content: '// ' / '';
    color: var(--accent);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .stats li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 4px;
    background: var(--bg);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
  }

  .stats__value {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
  }

  .stats__label {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .link-list {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link-list a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    color: var(--text);
    border: 1px solid transparent;
    border-radius: var(--radius);
    transition: border-color 0.15s, background-color 0.15s;
  }

  .link-list a:hover {
    background: var(--bg-sidebar);
    border-color: var(--accent-border);
  }

  .link-list__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    color: var(--accent);
    background: var(--accent-softer);
    border-radius: var(--radius);
  }

  .link-list__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }

  .link-list__name {
    font-weight: 600;
  }

  .link-list__handle {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-faint);
    overflow-wrap: anywhere;
  }

  .link-list a > :global(svg:last-child) {
    margin-left: auto;
    color: var(--text-faint);
  }

  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .about__side {
      position: static;
    }
  }
</style>
