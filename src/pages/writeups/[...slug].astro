---
import { render } from 'astro:content';
import WriteupLayout from '../../layouts/WriteupLayout.astro';
import { getWriteups, type Writeup } from '../../lib/posts';

export async function getStaticPaths() {
  const writeups = await getWriteups(); // newest first
  return writeups.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: writeups[i - 1], prev: writeups[i + 1] },
  }));
}

interface Props {
  entry: Writeup;
  prev?: Writeup;
  next?: Writeup;
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<WriteupLayout entry={entry} headings={headings} prev={prev} next={next}>
  <Content />
</WriteupLayout>
