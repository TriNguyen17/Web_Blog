---
import { render } from 'astro:content';
import PhotoPostLayout from '../../layouts/PhotoPostLayout.astro';
import { getPhotoPosts, type PhotoPost } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPhotoPosts(); // newest first
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: posts[i - 1], prev: posts[i + 1] },
  }));
}

interface Props {
  entry: PhotoPost;
  prev?: PhotoPost;
  next?: PhotoPost;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const hasBody = (entry.body ?? '').trim().length > 0;
---

<PhotoPostLayout entry={entry} prev={prev} next={next} hasBody={hasBody}>
  <Content />
</PhotoPostLayout>
