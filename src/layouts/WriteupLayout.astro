---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ChallengeBoard from '../components/writeup/ChallengeBoard.astro';
import TableOfContents from '../components/writeup/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import ShareBar from '../components/ShareBar.astro';
import Icon from '../components/Icon.astro';
import { buildBoard, buildToc, parseRank } from '../lib/ctf';
import { SITE } from '../config';
import { writeupUrl, type Writeup } from '../lib/posts';
import { formatDate, isoDate, readingTime, url } from '../lib/utils';

interface Props {
  entry: Writeup;
  headings: MarkdownHeading[];
  prev?: Writeup;
  next?: Writeup;
}

const { entry, headings, prev, next } = Astro.props;
const { data } = entry;

const { toc, entries, missing } = buildToc(headings, data.challenges);
const board = buildBoard(data.challenges, entries);
if (missing.length) {
  console.warn(
    `[writeups/${entry.id}] No "## heading" found for: ${missing.map((c) => c.name).join(', ')}. ` +
      'The heading text must equal the challenge name (or set `id`).',
  );
}

const minutes = readingTime(entry.body);
const hasBoard = data.challenges.length > 0;
const rank = parseRank(data.ctf.rank);
const topPct = rank ? new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 1 }).format(rank.top) : undefined;

const jsonLd = {
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  ...(data.updatedDate && { dateModified: data.updatedDate.toISOString() }),
  author: { '@type': 'Person', name: SITE.author },
  inLanguage: SITE.lang,
  keywords: data.tags.join(', '),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.cover}
  type="article"
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
  tags={data.tags}
  jsonLd={jsonLd}
>
  <div class="read-progress" aria-hidden="true"><span data-read-progress></span></div>

  <div class="writeup">
    <TableOfContents toc={toc} ctfName={data.ctf.name} hasBoard={hasBoard} />

    <article class="writeup__main">
      <header class:list={['writeup__hero', { 'writeup__hero--solo': !hasBoard }]}>
        <nav class="breadcrumb" aria-label="Đường dẫn">
          <a href={url('/writeups/')}>writeups</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{entry.id}</span>
        </nav>

        <h1 class="writeup__title">{data.title}</h1>
        <p class="writeup__desc">{data.description}</p>

        <ul class="writeup__meta">
          <li>
            <Icon name="calendar" size={15} />
            <span class="sr-only">Ngày đăng:</span>
            <time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
          </li>
          <li><Icon name="clock" size={15} /> {minutes} phút đọc</li>
        </ul>

        <dl class="ctf-card">
          <div class="ctf-card__item ctf-card__item--name">
            <dt>Giải</dt>
            <dd>
              {
                data.ctf.url ? (
                  <a href={data.ctf.url} target="_blank" rel="noopener">
                    {data.ctf.name} <Icon name="external" size={13} />
                  </a>
                ) : (
                  data.ctf.name
                )
              }
            </dd>
          </div>
          {data.ctf.date && (<div class="ctf-card__item"><dt>Thời gian</dt><dd>{data.ctf.date}</dd></div>)}
          {data.ctf.format && (<div class="ctf-card__item"><dt>Hình thức</dt><dd>{data.ctf.format}</dd></div>)}
          {data.ctf.team && (<div class="ctf-card__item"><dt>Team</dt><dd>{data.ctf.team}</dd></div>)}
          {
            data.ctf.rank && (
              <div class="ctf-card__item">
                <dt>Hạng</dt>
                <dd>
                  <span class="ctf-card__rank">{data.ctf.rank}</span>
                  {topPct && <span class="ctf-card__top">top {topPct}%</span>}
                </dd>
              </div>
            )
          }
        </dl>
        <TagList tags={data.tags} />
      </header>

      {hasBoard && <ChallengeBoard groups={board} />}

      <div class="prose writeup-content">
        <slot />
      </div>

      {
        data.updatedDate && (
          <p class="writeup__updated">Cập nhật lần cuối: {formatDate(data.updatedDate)}</p>
        )
      }

      <ShareBar title={data.title} />

      {(prev || next) && (
      <nav class="post-nav" aria-label="Write-up khác">
        {
          prev ? (
            <a class="post-nav__link" href={writeupUrl(prev)} rel="prev">
              <span class="post-nav__label">
                <Icon name="arrow-left" size={14} /> Cũ hơn
              </span>
              <span class="post-nav__title">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="post-nav__link post-nav__link--next" href={writeupUrl(next)} rel="next">
              <span class="post-nav__label">
                Mới hơn <Icon name="arrow-right" size={14} />
              </span>
              <span class="post-nav__title">{next.data.title}</span>
            </a>
          )
        }
      </nav>
      )}
    </article>
  </div>
</BaseLayout>

<style>
  .read-progress {
    position: fixed;
    top: var(--header-h);
    left: 0;
    right: 0;
    z-index: 45;
    height: 2px;
    pointer-events: none;
  }

  .read-progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .writeup {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    align-items: start;
  }

  .writeup__main {
    width: 100%;
    max-width: 920px;
    margin-inline: auto;
    padding: 40px clamp(20px, 4vw, 56px) 80px;
  }

  @media (max-width: 1023px) {
    .writeup {
      grid-template-columns: minmax(0, 1fr);
    }

    .writeup__main {
      padding: 28px var(--gutter) 96px;
    }
  }

  .breadcrumb {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .writeup__title {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    letter-spacing: -0.01em;
  }

  .writeup__desc {
    margin: 0 0 18px;
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .writeup__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .writeup__meta li,
  .writeup__meta a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .writeup__meta :global(svg) {
    color: var(--accent);
  }

  /* Competition info: labelled, so dates / team / rank can't be confused. */
  .ctf-card {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0 0 16px;
    font-family: var(--font-mono);
    background: var(--bg-sidebar);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
  }

  .ctf-card__item {
    flex: 1 1 auto;
    padding: 10px 16px;
    border-right: 1px solid var(--border-soft);
  }

  .ctf-card__item:last-child {
    border-right: 0;
  }

  .ctf-card dt {
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .ctf-card dd {
    margin: 2px 0 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }

  .ctf-card dd a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-text);
  }

  .ctf-card__rank {
    color: var(--accent-text);
  }

  .ctf-card__top {
    margin-left: 8px;
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .ctf-card__item {
      flex-basis: 50%;
      border-right: 0;
      border-bottom: 1px solid var(--border-soft);
    }

    .ctf-card__item--name {
      flex-basis: 100%;
    }
  }

  /* Comfortable line length for prose; code, boards and figures keep the
     full column. */
  .writeup-content :global(:is(p:not(:has(> img)), li, blockquote, dl, h2, h3, h4)) {
    max-width: 74ch;
  }

  .writeup__hero--solo {
    margin-bottom: 32px;
  }

  .writeup__updated {
    margin-top: 40px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border-soft);
  }

  .post-nav__link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s;
  }

  .post-nav__link:hover {
    border-color: var(--accent-border);
  }

  .post-nav__link--next {
    grid-column: 2;
    text-align: right;
    align-items: flex-end;
  }

  .post-nav__label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .post-nav__title {
    color: var(--text);
    font-weight: 600;
  }

  /* ------------------------------------------------------------------
     Write-up content: markup produced by src/plugins/rehype-ctf-sections.mjs
     ------------------------------------------------------------------ */
  .writeup-content :global(.ctf-challenge) {
    margin-top: 72px;
  }

  .writeup-content :global(.ctf-challenge__header) {
    margin-bottom: 28px;
    padding: 18px 20px 16px;
    background:
      linear-gradient(90deg, var(--accent-soft), transparent 70%),
      var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
  }

  .writeup-content :global(.ctf-challenge__title) {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: clamp(1.35rem, 3vw, 1.65rem);
    letter-spacing: -0.01em;
  }

  .writeup-content :global(.ctf-challenge__title::before) {
    content: '>';
    content: '>' / '';
    margin-right: 0.6ch;
    color: var(--accent);
  }

  .writeup-content :global(.ctf-meta) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }

  .writeup-content :global(.ctf-meta__item) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .writeup-content :global(.ctf-meta__points) {
    font-weight: 700;
    color: var(--accent-text);
  }

  /* "#" link next to challenge / step headings (copies the section URL). */
  .writeup-content :global(.ctf-challenge__header) {
    position: relative;
  }

  .writeup-content :global(.heading-anchor) {
    position: absolute;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-faint);
    border-radius: var(--radius);
    opacity: 0;
    transition: opacity 0.15s, color 0.15s;
  }

  .writeup-content :global(.ctf-challenge__header > .heading-anchor) {
    top: 14px;
    right: 12px;
  }

  .writeup-content :global(.ctf-step > .heading-anchor) {
    top: 18px;
    right: 0;
  }

  .writeup-content :global(.ctf-section) {
    position: relative;
  }

  .writeup-content :global(.ctf-section > .heading-anchor) {
    top: 0;
    right: 0;
  }

  .writeup-content :global(:is(.ctf-challenge__header, .ctf-step, .ctf-section):hover > .heading-anchor),
  .writeup-content :global(.heading-anchor:focus-visible),
  .writeup-content :global(.heading-anchor[data-copied]) {
    opacity: 1;
  }

  .writeup-content :global(.heading-anchor:hover),
  .writeup-content :global(.heading-anchor[data-copied]) {
    color: var(--accent-text);
  }

  .writeup-content :global(.ctf-step > h3),
  .writeup-content :global(.ctf-challenge__title),
  .writeup-content :global(.ctf-section > h2) {
    padding-right: 36px;
  }

  /* Touch screens have no hover: keep the links visible, but quiet. */
  @media (hover: none) {
    .writeup-content :global(.heading-anchor) {
      opacity: 0.55;
    }
  }

  /* Copy button after a flag */
  .writeup-content :global(.flag-copy) {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-left: 6px;
    padding: 0;
    vertical-align: middle;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .writeup-content :global(.flag-copy svg) {
    width: 15px;
    height: 15px;
  }

  .writeup-content :global(.flag-copy:hover) {
    color: var(--accent-text);
    border-color: var(--accent-border);
  }

  /* Steps form a small timeline */
  .writeup-content :global(.ctf-step) {
    position: relative;
    margin-left: 6px;
    padding: 0 0 8px 26px;
    border-left: 1px solid var(--border);
  }

  .writeup-content :global(.ctf-step > h3) {
    position: relative;
    margin-top: 0;
    padding-top: 22px;
    font-family: var(--font-mono);
    font-size: 1.08rem;
  }

  .writeup-content :global(.ctf-step > h3::before) {
    content: '';
    position: absolute;
    left: -32px;
    top: 27px;
    width: 11px;
    height: 11px;
    background: var(--bg);
    border: 2px solid var(--accent);
    border-radius: 50%;
  }

  .writeup-content :global(.ctf-step--flag) {
    border-left-color: transparent;
  }

  .writeup-content :global(.ctf-step--flag > h3::before) {
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  .writeup-content :global(.ctf-step--flag > :not(h3)) {
    border-color: var(--accent-border);
  }

  .writeup-content :global(.ctf-step--flag p code) {
    display: inline-block;
    padding: 8px 14px;
    font-size: 0.95rem;
    color: var(--accent-text);
    background: var(--accent-soft);
    border: 1px dashed var(--accent-border);
    border-radius: var(--radius);
    word-break: break-all;
  }

  .writeup-content :global(.ctf-section) {
    margin-top: 64px;
  }

  @media (max-width: 600px) {
    .writeup-content :global(.ctf-step) {
      padding-left: 18px;
    }

    .writeup-content :global(.ctf-step > h3::before) {
      left: -24px;
    }

    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav__link--next {
      grid-column: 1;
    }
  }
</style>
